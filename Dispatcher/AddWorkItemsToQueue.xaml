                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:Int32">[out_ItemsAdded + 1]</InArgument>
                    </Assign.Value>
                  </Assign>
                  <ui:LogMessage DisplayName="Log Message - Item added" Level="Trace" Message="[&quot;Queue item added. WIID=&quot; &amp; wiid]" sap2010:WorkflowViewState.IdRef="LogMessage_2" />
                </Sequence>
